{
  "id": "receipt",
  "name": "Receipt (PLACEHOLDER starter)",
  "placeholder": true,
  "defaultStyle": "receipt-thermal",
  "aspect": 1.4,
  "slots": [
    {
      "name": "logo",
      "kind": "image",
      "label": "Logo (optional)"
    },
    {
      "name": "store",
      "kind": "value",
      "label": "Store name"
    },
    {
      "name": "address",
      "kind": "markdown",
      "label": "Address and contact lines"
    },
    {
      "name": "details",
      "kind": "markdown",
      "label": "Store, till and operator details"
    },
    {
      "name": "date",
      "kind": "value",
      "label": "Date"
    },
    {
      "name": "time",
      "kind": "value",
      "label": "Time"
    },
    {
      "name": "reference",
      "kind": "value",
      "label": "Reference or till number"
    },
    {
      "name": "items",
      "kind": "items",
      "required": true,
      "label": "Items"
    },
    {
      "name": "payment",
      "kind": "markdown",
      "label": "Payment details (card, approval code, terminal)"
    },
    {
      "name": "notes",
      "kind": "markdown",
      "label": "Notes (savings, loyalty, survey, slogan)"
    },
    {
      "name": "footer",
      "kind": "value",
      "label": "Closing message"
    },
    {
      "name": "barcodeNumber",
      "kind": "value",
      "label": "Number printed under the barcode"
    },
    {
      "name": "qr",
      "kind": "value",
      "label": "QR code message (a phone can scan it)",
      "maxLength": 300
    },
    {
      "name": "qrCaption",
      "kind": "value",
      "label": "Text under the QR code"
    }
  ],
  "layout": {
    "block": "stack",
    "children": [
      {
        "block": "image",
        "slot": "logo",
        "props": {
          "width": "34%"
        },
        "section": "heading"
      },
      {
        "block": "title",
        "slot": "store",
        "props": {
          "size": "large"
        },
        "section": "heading"
      },
      {
        "block": "paragraph",
        "slot": "address",
        "props": {
          "align": "center"
        },
        "section": "heading"
      },
      {
        "block": "paragraph",
        "slot": "details",
        "props": {
          "align": "center"
        },
        "section": "heading"
      },
      {
        "block": "rule"
      },
      {
        "block": "split-row",
        "props": {
          "left": "date",
          "right": "time"
        },
        "section": "topline"
      },
      {
        "block": "field-row",
        "slot": "reference",
        "props": {
          "label": "Ref"
        },
        "section": "topline"
      },
      {
        "block": "rule"
      },
      {
        "block": "items-list",
        "slot": "items",
        "props": {
          "includedTaxLines": false,
          "savings": true
        },
        "section": "body"
      },
      {
        "block": "tender",
        "slot": "items",
        "section": "body"
      },
      {
        "block": "rule"
      },
      {
        "block": "tax-table",
        "slot": "items",
        "section": "body"
      },
      {
        "block": "paragraph",
        "slot": "payment",
        "props": {
          "align": "left"
        },
        "section": "footer"
      },
      {
        "block": "paragraph",
        "slot": "notes",
        "props": {
          "align": "center"
        },
        "section": "footer"
      },
      {
        "block": "caption",
        "slot": "footer",
        "section": "footer"
      },
      {
        "block": "barcode",
        "props": {
          "seed": "reference",
          "number": "barcodeNumber"
        },
        "section": "footer"
      },
      {
        "block": "qr-code",
        "slot": "qr",
        "section": "footer",
        "props": {
          "caption": "qrCaption",
          "width": "28%"
        }
      }
    ]
  },
  "defaultWidth": 0.17,
  "sections": [
    {
      "id": "heading",
      "name": "Heading",
      "open": true
    },
    {
      "id": "topline",
      "name": "Top line",
      "open": true
    },
    {
      "id": "body",
      "name": "Main body",
      "open": true
    },
    {
      "id": "footer",
      "name": "Footer"
    }
  ]
}
