{
  "name": "@archive/author",
  "version": "0.0.0",
  "private": true,
  "description": "Archive authoring tool (Electron desktop app).",
  "author": "ink-and-ember-forge",
  "homepage": "https://github.com/ink-and-ember-forge/Site-31-Archive",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && electron .",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig renderer/tsconfig.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder --publish never"
  },
  "devDependencies": {
    "@archive/casefile": "*",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.0.0",
    "electron": "45.4.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "svelte": "^5.59.0",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.site31.archive.author",
    "productName": "Archive Author",
    "files": [
      "dist/main.cjs",
      "dist/preload.cjs",
      "dist/renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "executableName": "archive-author"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "dist/viewer",
        "to": "viewer"
      },
      {
        "from": "dist/theme",
        "to": "theme"
      }
    ]
  }
}
