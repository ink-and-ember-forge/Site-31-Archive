{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "case.schema.json",
  "title": "Case file manifest (case.json), format v1",
  "type": "object",
  "required": ["formatVersion", "id", "title", "submissionDate", "centralDocument", "documents"],
  "properties": {
    "formatVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "submissionDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "folderLabel": { "type": "string" },
    "order": { "type": "number" },
    "centralDocument": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "layout"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "hidden": { "type": "boolean" },
          "layout": {
            "type": "object",
            "required": ["x", "y", "width"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "rotation": { "type": "number", "minimum": -180, "maximum": 180 }
            }
          }
        }
      }
    },
    "voiceover": {
      "type": "object",
      "required": ["file"],
      "properties": {
        "file": { "type": "string" },
        "transcript": { "type": "string" }
      }
    }
  }
}
