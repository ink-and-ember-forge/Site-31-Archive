{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger.schema.json",
  "title": "Ledger references (ledger.json), format v1",
  "type": "object",
  "required": ["entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["element", "layer"],
        "properties": {
          "element": { "type": "string", "minLength": 1 },
          "layer": { "enum": ["main", "marginalia", "supplementary", "registry"] }
        }
      }
    }
  }
}
