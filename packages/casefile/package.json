{
  "name": "@archive/casefile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "archive": "tsx src/cli.ts",
    "archive:samples": "tsx src/cli.ts --samples",
    "archive:preview": "tsx src/cli.ts --samples-if-empty",
    "validate": "tsx src/validate-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "fflate": "^0.8.3"
  },
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./schema/*": "./schema/*",
    "./authoring": "./src/authoring.ts"
  }
}
