{
  "name": "site-31-archive",
  "version": "0.1.2",
  "private": true,
  "description": "Episodic digital anthology told through an archive: viewer, authoring tool and case file package format.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:viewer": "npm run dev -w @archive/viewer",
    "dev:author": "npm run dev -w @archive/author",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "validate": "npm run validate -w @archive/casefile --"
  }
}
